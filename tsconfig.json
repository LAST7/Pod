{
    "$schema": "https://www.schemastore.org/tsconfig.json",
    "compilerOptions": {
        "target": "es2025",
        "lib": ["ES2025", "ESNext.Temporal"],
        "types": ["node"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": "./dist",
        "rootDir": "./src",
        "paths": {
            "#*": ["./src/*"]
        },
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"]
}
