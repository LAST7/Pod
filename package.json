{
    "name": "pod",
    "version": "0.1.1",
    "description": "A personal AI companion, built for curiosity and fun.",
    "scripts": {
        "build": "tsc",
        "dev": "APP_ENV=development POD_PROFILE=development tsx src/main.ts",
        "dev:production-prompt": "APP_ENV=development POD_PROFILE=production tsx src/main.ts",
        "start": "APP_ENV=production node dist/main.js",
        "start:dev-prompt": "APP_ENV=production POD_PROFILE=development node dist/main.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "bin": {
            "pod": "./dist/main.js"
        }
    },
    "imports": {
        "#*": "./dist/*"
    },
    "keywords": [],
    "author": "Last",
    "license": "MIT",
    "packageManager": "pnpm@12.8.1",
    "type": "module",
    "dependencies": {
        "@earendil-works/pi-agent-core": "^1.5.2",
        "@earendil-works/pi-ai": "^1.5.2",
        "@earendil-works/pi-tui": "^1.5.2",
        "better-sqlite3": "^13.2.0",
        "typebox": "^1.4.7"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.6",
        "oxfmt": "^0.78.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}
